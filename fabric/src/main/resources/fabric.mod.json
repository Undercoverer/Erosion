{
  "schemaVersion": 1,
  "id": "erosion",
  "version": "${version}",
  "name": "erosion",
  "description": "erosion filter in Minecraft",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/erosion/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.github.undercoverer.erosion.client.ErosionDataGenerator"
    ],
    "client": [
      "com.github.undercoverer.erosion.client.ErosionClient"
    ],
    "main": [
      "com.github.undercoverer.erosion.Erosion"
    ]
  },
  "mixins": [
    "erosion.mixins.json",
    {
      "config": "erosion.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
